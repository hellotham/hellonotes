//
// Secrets.example.xcconfig — committed template.
//
// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your
// own credentials. The app builds without it — cloud providers then show
// "not configured" until keys are supplied.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Dropbox: create an app at https://www.dropbox.com/developers/apps
//   (Scoped access; redirect URI hellonotes://dropbox-auth). PKCE — key only.
// Box: create a Custom App (User Authentication / OAuth 2.0) at
//   https://app.box.com/developers/console (redirect URI hellonotes://box-auth).
//   Box's token exchange requires the client secret.
//

DROPBOX_APP_KEY =

BOX_CLIENT_ID =
BOX_CLIENT_SECRET =

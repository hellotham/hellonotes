---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Big page heading. Omit on pages that render their own hero (the landing page). */
  heading?: string;
  /** Supporting line under the heading. */
  intro?: string;
  ogImage?: string;
  appSchema?: boolean;
}

const { title, description, heading, intro, ogImage, appSchema } = Astro.props;
---

<Layout title={title} description={description} ogImage={ogImage} appSchema={appSchema}>
  {/* First focusable on every page. Without it the nav is seven tab stops that a
      keyboard-only reader pays on all sixteen pages — the wordmark, five links
      and the appearance toggle, which the roving tabindex in ThemeToggle keeps
      to one. Landmarks bypass those only for someone driving a screen reader. */}
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:border focus:border-edge focus:bg-card focus:px-4 focus:py-2 focus:text-[15px] focus:font-semibold focus:text-ink"
    >Skip to content</a
  >

  <Nav />

  {
    heading && (
      <header class="border-b border-line bg-linear-to-b from-bg2/60 to-bg px-6 py-14">
        <div class="mx-auto max-w-[1120px]">
          <h1 class="text-[clamp(32px,5vw,46px)] font-extrabold tracking-[-0.02em]">{heading}</h1>
          {intro && <p class="mt-3 max-w-[720px] text-lg text-muted">{intro}</p>}
        </div>
      </header>
    )
  }

  {/* tabindex=-1 so the skip link actually moves focus here, not just scroll. */}
  <main id="main" tabindex="-1">
    <slot />
  </main>

  <Footer />
</Layout>

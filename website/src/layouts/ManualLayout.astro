---
import PageLayout from './PageLayout.astro';
import Prose from '../components/Prose.astro';
import { href } from '../lib/paths';
import { MANUAL } from '../lib/site';

interface Props {
  /** Slug of the current section — drives the sidebar highlight and prev/next. */
  slug: string;
}

const { slug } = Astro.props;
const index = MANUAL.findIndex((s) => s.slug === slug);
const section = MANUAL[index];
const prev = index > 0 ? MANUAL[index - 1] : undefined;
const next = index < MANUAL.length - 1 ? MANUAL[index + 1] : undefined;
---

<PageLayout
  title={`${section.title} — HelloNotes manual`}
  description={section.blurb}
  heading={section.title}
  intro={section.blurb}
>
  <div class="mx-auto grid max-w-[1120px] gap-12 px-6 py-12 lg:grid-cols-[220px_1fr]">
    <!-- Section list. Sticky on wide screens; a plain list above the content on mobile. -->
    <aside class="lg:sticky lg:top-[86px] lg:self-start">
      <h2 class="mb-3 text-xs font-bold tracking-wider text-muted uppercase">Manual</h2>
      <ul class="space-y-1 text-[15px]">
        {
          MANUAL.map((s) => (
            <li>
              <a
                href={href(`/manual/${s.slug}`)}
                aria-current={s.slug === slug ? 'page' : undefined}
                class:list={[
                  'block rounded-lg px-3 py-1.5 transition-colors',
                  s.slug === slug
                    ? 'bg-chip font-semibold text-emphasis'
                    : 'text-muted hover:bg-chip hover:text-emphasis',
                ]}
              >
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    {/* min-w-0 — see the note in download.astro: without it the <pre> blocks in
        the editor and links sections widen the whole page on a phone. */}
    <div class="min-w-0">
      <Prose>
        <slot />
      </Prose>

      <nav
        class="mt-14 flex flex-wrap gap-4 border-t border-line pt-6 text-[15px]"
        aria-label="Manual sections"
      >
        {
          prev && (
            <a href={href(`/manual/${prev.slug}`)} class="text-muted hover:text-emphasis">
              ← {prev.title}
            </a>
          )
        }
        <span class="flex-1"></span>
        {
          next && (
            <a href={href(`/manual/${next.slug}`)} class="font-semibold text-link hover:text-emphasis">
              {next.title} →
            </a>
          )
        }
      </nav>
    </div>
  </div>
</PageLayout>

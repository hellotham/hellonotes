---
import PageLayout from '../layouts/PageLayout.astro';
import Shot from '../components/Shot.astro';
import { href } from '../lib/paths';
import { APP, PUBLISHER, DOWNLOAD, REPO } from '../lib/site';
import { byId } from '../lib/screens';

const features = [
  {
    icon: '📄',
    title: 'Local-first, plain files',
    body: 'Your notes are ordinary <code>.md</code> files in a folder you choose. No database, no lock-in, readable in any editor — and still yours if you ever stop using HelloNotes.',
  },
  {
    icon: '✍️',
    title: 'A native live editor',
    body: 'Built on TextKit 2, not a browser engine. Markdown styles as you type, with syntax-highlighted code, LaTeX maths, Mermaid diagrams and collapsible callouts rendered natively.',
  },
  {
    icon: '🔗',
    title: 'Connected thinking',
    body: '<code>[[Wiki-links]]</code> with autocomplete and aliases, backlinks, unlinked mentions, note transclusion, and an interactive graph of how everything relates.',
  },
  {
    icon: '🔎',
    title: 'Find anything, fast',
    body: 'Full-text search with snippets, Open Quickly, nested tags with autocomplete, bookmarks, daily notes and templates.',
  },
  {
    icon: '✨',
    title: 'Intelligence on your Mac',
    body: 'Summarise, suggest tags and links, find the links you meant to make, or ask questions across your whole library — on-device with Apple Intelligence, or your own model if you prefer.',
  },
  {
    icon: '🕘',
    title: 'Version history with Git',
    body: 'Initialise a repository, commit as you write, browse any note’s history and restore an earlier version. Sync to your own remote — never to us.',
  },
];

const hero = byId('maths');
const showcase = [
  { screen: byId('callouts'), cap: 'Callouts & properties' },
  { screen: byId('ask'), cap: 'Ask your library' },
  { screen: byId('graph'), cap: 'Graph view' },
];
---

<PageLayout
  title="HelloNotes — a private, local-first Markdown knowledge base for Mac"
  description="HelloNotes is a fast, private, local-first Markdown knowledge base for your Mac. Wiki-links, backlinks, a graph view, diagrams, maths and on-device AI — over notes that stay plain files you own."
  appSchema
>
  <!-- Hero -->
  <header class="relative overflow-hidden px-6 pt-20 pb-16 text-center">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-[-20%] top-[-40%] h-[620px] blur-[10px]"
      style="background:
        radial-gradient(60% 60% at 50% 0%, rgba(124,58,237,.45), transparent 70%),
        radial-gradient(50% 50% at 80% 10%, rgba(236,72,153,.35), transparent 70%),
        radial-gradient(40% 40% at 15% 15%, rgba(245,158,11,.28), transparent 70%);"
    >
    </div>

    <div class="relative mx-auto max-w-[900px]">
      <img
        src={href('assets/icon.png')}
        alt={`${APP.name} app icon`}
        width="120"
        height="120"
        class="mx-auto mb-6 size-30 rounded-[26px] shadow-[0_24px_60px_rgba(236,72,153,.35)]"
      />
      <h1 class="text-[clamp(40px,7vw,66px)] font-extrabold tracking-[-0.03em]">
        Think in <span class="gradient-text">plain Markdown.</span>
      </h1>
      <p class="mx-auto mt-4 max-w-[640px] text-[clamp(18px,2.4vw,23px)] text-muted">
        A fast, private, local-first knowledge base for your Mac. Wiki-links, backlinks, a graph
        view, diagrams, maths and on-device AI — over notes that stay plain files you own.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3.5">
        <a
          href={href('/download')}
          class="brand-gradient inline-flex items-center gap-2.5 rounded-full px-6 py-3.5 text-base font-bold text-white shadow-cta transition hover:brightness-95"
        >
          Download for Mac
        </a>
        <a
          href={href('/features')}
          class="inline-flex items-center gap-2.5 rounded-full border border-line bg-chip px-6 py-3.5 text-base font-bold text-ink transition hover:border-edge hover:text-emphasis"
        >
          Explore the features
        </a>
      </div>

      <p class="mt-4 text-sm text-muted">
        Version {APP.version} · {APP.minOS} · {APP.architectures} · Free
      </p>
      <p class="mt-1 text-sm text-muted">
        Signed and notarised by Apple · No account · Nothing collected
      </p>
    </div>

    <div class="relative mx-auto mt-14 max-w-[1000px]">
      <Shot
        screen={hero}
        widths={[640, 1000, 1600]}
        sizes="(max-width: 1000px) 100vw, 1000px"
        loading="eager"
        class="w-full rounded-card border border-line shadow-plate"
      />
    </div>
  </header>

  <!-- Features -->
  <section class="px-6 py-20">
    <div class="mx-auto max-w-[1120px]">
      <div class="mx-auto mb-12 max-w-[680px] text-center">
        <h2 class="text-[clamp(28px,4vw,40px)] font-extrabold tracking-[-0.02em]">
          Everything a knowledge base should be
        </h2>
        <p class="mt-3 text-lg text-muted">
          Powerful where it counts, and out of your way everywhere else.
        </p>
      </div>

      <div class="grid gap-[18px] [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]">
        {
          features.map((f) => (
            <div class="rounded-card border border-line bg-card p-[26px]">
              <div class="mb-4 grid size-[46px] place-items-center rounded-xl bg-pink/15 text-2xl">
                {f.icon}
              </div>
              <h3 class="text-[19px] font-bold tracking-[-0.01em]">{f.title}</h3>
              <p
                class="mt-2 text-[15px] text-muted [&_code]:rounded [&_code]:bg-chip [&_code]:px-1"
                set:html={f.body}
              />
            </div>
          ))
        }
      </div>

      <p class="mt-10 text-center">
        <a href={href('/features')} class="font-semibold text-link hover:text-emphasis">
          See the full feature list →
        </a>
      </p>
    </div>
  </section>

  <!-- Showcase -->
  <section class="border-y border-line bg-bg2/40 px-6 py-20">
    <div class="mx-auto max-w-[1120px]">
      <div class="mx-auto mb-12 max-w-[680px] text-center">
        <h2 class="text-[clamp(28px,4vw,40px)] font-extrabold tracking-[-0.02em]">
          See it in action
        </h2>
        <p class="mt-3 text-lg text-muted">
          A calm, keyboard-first editor with real power under the hood.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          showcase.map((s) => (
            <figure>
              <Shot
                screen={s.screen}
                widths={[380, 760]}
                sizes="(max-width: 768px) 100vw, 33vw"
                class="w-full rounded-card border border-line shadow-card"
              />
              <figcaption class="mt-3 text-center text-sm text-muted">{s.cap}</figcaption>
            </figure>
          ))
        }
      </div>

      <p class="mt-10 text-center">
        <a href={href('/screenshots')} class="font-semibold text-link hover:text-emphasis">
          Browse all screenshots →
        </a>
      </p>
    </div>
  </section>

  <!-- Privacy -->
  <section class="px-6 py-20">
    <div class="mx-auto max-w-[820px] text-center">
      <div class="text-[40px]">🔒</div>
      <h2 class="mt-3 text-[clamp(26px,3.4vw,34px)] font-extrabold tracking-[-0.02em]">
        Private by design
      </h2>
      <p class="mx-auto mt-4 max-w-[640px] text-lg text-muted">
        {APP.name} collects nothing. There is no account, no analytics and no tracking, and we operate
        no server that could receive your notes. On-device AI runs locally and never sends your
        writing anywhere.
      </p>
      <p class="mt-5">
        <a href={href('/privacy')} class="font-semibold text-link hover:text-emphasis">
          Read the privacy policy →
        </a>
      </p>
    </div>
  </section>

  <!-- Download CTA -->
  <section class="border-t border-line bg-linear-to-b from-bg to-bg2 px-6 py-20">
    <div class="mx-auto max-w-[820px] text-center">
      <h2 class="text-[clamp(26px,3.4vw,34px)] font-extrabold tracking-[-0.02em]">
        Start writing today
      </h2>
      <p class="mx-auto mt-3 max-w-[560px] text-muted">
        {APP.name} {APP.version} is a free, signed and notarised download for {APP.minOS}.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3.5">
        <a
          href={href('/download')}
          class="brand-gradient inline-flex items-center gap-2.5 rounded-full px-6 py-3.5 text-base font-bold text-white shadow-cta transition hover:brightness-95"
        >
          Download {DOWNLOAD.fileName}
        </a>
        <a
          href={REPO}
          class="inline-flex items-center gap-2.5 rounded-full border border-line bg-chip px-6 py-3.5 text-base font-bold text-ink transition hover:border-edge hover:text-emphasis"
        >
          View source on GitHub
        </a>
      </div>
      <p class="mt-6 text-sm text-muted">
        Published by{' '}
        <a href={PUBLISHER.site} class="font-semibold text-link hover:text-emphasis">{PUBLISHER.name}</a>.
      </p>
    </div>
  </section>
</PageLayout>

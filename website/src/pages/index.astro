---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { href } from '../lib/paths';

const features = [
  {
    icon: '📄',
    title: 'Local-first, plain files',
    body: 'Your notes are ordinary <code class="rounded bg-white/5 px-1">.md</code> files in a folder you choose. No lock-in, no database, readable in any editor.',
  },
  {
    icon: '✍️',
    title: 'Live Markdown',
    body: 'A native editor with live styling, syntax-highlighted code, inline LaTeX math, Mermaid diagrams, callouts and hidden comments.',
  },
  {
    icon: '🔗',
    title: 'Connected thinking',
    body: '[[Wiki-links]] and heading links with autocomplete, backlinks, unlinked mentions, note transclusion, and an interactive graph view.',
  },
  {
    icon: '🔎',
    title: 'Find anything',
    body: 'Full-text search, “Open Quickly”, nested #tags with autocomplete, bookmarks, daily notes and templates.',
  },
  {
    icon: '✨',
    title: 'On-device intelligence',
    body: 'Summarise, suggest tags and links, expand a stub, or “ask your vault” — powered by Apple Intelligence, entirely on your Mac.',
  },
  {
    icon: '🕘',
    title: 'Version history with Git',
    body: 'Built-in Git: initialise a repo, browse a note’s history and restore earlier versions. Export to HTML or PDF anytime.',
  },
];

const shots = [
  { src: 'assets/shot_02.png', alt: 'LaTeX math and Mermaid diagrams rendered inline' },
  { src: 'assets/shot_03.png', alt: 'Callouts, properties and rich Markdown' },
  { src: 'assets/shot_05.png', alt: 'Ask your vault — on-device AI answers with citations' },
  { src: 'assets/shot_04.png', alt: 'Graph view of how notes connect' },
  { src: 'assets/shot_01.png', alt: 'The notes sidebar — your files, local and private' },
];
---

<Layout
  title="HelloNotes — a private, local-first Markdown knowledge base for Mac"
  description="HelloNotes is a fast, private, local-first Markdown knowledge base for your Mac. Wiki-links, backlinks, a graph view, diagrams, math and on-device AI — your notes stay plain files you own."
>
  <Nav />

  <header class="relative overflow-hidden px-6 pt-24 pb-18 text-center">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-[-20%] top-[-40%] h-[620px] blur-[10px]"
      style="background:
        radial-gradient(60% 60% at 50% 0%, rgba(124,58,237,.45), transparent 70%),
        radial-gradient(50% 50% at 80% 10%, rgba(236,72,153,.35), transparent 70%),
        radial-gradient(40% 40% at 15% 15%, rgba(245,158,11,.28), transparent 70%);"
    >
    </div>

    <div class="relative mx-auto max-w-[1120px]">
      <img
        src={href('assets/icon.png')}
        alt="HelloNotes app icon"
        width="128"
        height="128"
        class="mx-auto mb-6 size-32 rounded-[28px] shadow-[0_24px_60px_rgba(236,72,153,.35)]"
      />
      <h1 class="text-[clamp(40px,7vw,68px)] font-extrabold tracking-[-0.03em]">
        Think in <span class="gradient-text">plain Markdown.</span>
      </h1>
      <p class="mx-auto mt-3.5 max-w-[640px] text-[clamp(18px,2.4vw,23px)] text-muted">
        A fast, private, local-first knowledge base for your Mac. Wiki-links, backlinks, a graph
        view, diagrams, math and on-device AI — over notes that stay plain files you own.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3.5">
        <a
          href="#screens"
          class="brand-gradient inline-flex items-center gap-2.5 rounded-full px-[22px] py-3.5 text-base font-bold text-white shadow-[0_10px_30px_rgba(236,72,153,.35)] transition hover:brightness-110"
        >
          Coming to the Mac App Store
        </a>
        <a
          href="https://github.com/hellotham/hellonotes"
          class="inline-flex items-center gap-2.5 rounded-full border border-line bg-white/5 px-[22px] py-3.5 text-base font-bold text-ink transition hover:border-[#4a4360] hover:text-white"
        >
          View source on GitHub
        </a>
      </div>
      <p class="mt-3.5 text-sm text-muted">
        Requires macOS 15 or later · No account · No cloud required
      </p>
    </div>
  </header>

  <section id="features" class="px-6 py-[70px]">
    <div class="mx-auto max-w-[1120px]">
      <div class="mx-auto mb-11 max-w-[680px] text-center">
        <h2 class="text-[clamp(28px,4vw,40px)] font-extrabold tracking-[-0.02em]">
          Everything a knowledge base should be
        </h2>
        <p class="mt-3 text-lg text-muted">
          Powerful where it counts, and out of your way everywhere else.
        </p>
      </div>
      <div class="grid gap-[18px] [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]">
        {
          features.map((f) => (
            <div class="rounded-card border border-line bg-card p-[26px]">
              <div class="mb-4 grid size-[46px] place-items-center rounded-xl bg-pink/15 text-2xl">
                {f.icon}
              </div>
              <h3 class="text-[19px] font-bold tracking-[-0.01em]">{f.title}</h3>
              <p class="mt-2 text-[15px] text-muted" set:html={f.body} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="screens" class="px-6 py-[70px]">
    <div class="mx-auto max-w-[1120px]">
      <div class="mx-auto mb-11 max-w-[680px] text-center">
        <h2 class="text-[clamp(28px,4vw,40px)] font-extrabold tracking-[-0.02em]">
          See it in action
        </h2>
        <p class="mt-3 text-lg text-muted">
          A calm, keyboard-first editor with real power under the hood.
        </p>
      </div>
      <div class="flex flex-col gap-15">
        {
          shots.map((s) => (
            <div class="overflow-hidden rounded-card border border-line shadow-[0_30px_80px_rgba(0,0,0,.5)]">
              <img
                src={href(s.src)}
                alt={s.alt}
                loading="lazy"
                decoding="async"
                class="block w-full"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-linear-to-b from-bg to-bg2 px-6">
    <div class="mx-auto flex max-w-[1120px] flex-wrap items-center gap-7 py-12">
      <div class="text-[40px]">🔒</div>
      <div>
        <h3 class="text-2xl font-extrabold">Private by design</h3>
        <p class="mt-1.5 max-w-[620px] text-muted">
          HelloNotes collects nothing. There’s no account, no analytics and no tracking. On-device
          AI runs locally and never sends your notes anywhere.{' '}
          <a href={href('/privacy')} class="text-link hover:text-white">Read the privacy policy →</a>
        </p>
      </div>
    </div>
  </section>

  <Footer badge="🖥️ Mac · macOS 15+" />
</Layout>

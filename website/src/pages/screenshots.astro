---
import PageLayout from '../layouts/PageLayout.astro';
import Shot from '../components/Shot.astro';
import { href } from '../lib/paths';
import { SCREENS } from '../lib/screens';
---

<PageLayout
  title="Screenshots — HelloNotes"
  description="See HelloNotes in action, in both light and dark appearance: the native Markdown editor, inline maths and diagrams, callouts and properties, the graph view, and on-device AI answering questions from your notes."
  heading="Screenshots"
  intro="A closer look at the editor, the graph, and the on-device intelligence."
>
  <div class="mx-auto max-w-[1000px] px-6 py-12">
    {/*
      This page used to carry its own Light/Dark switch. Now that the whole site
      has one in the nav, a second control is just two things to disagree about —
      the shots follow the site's appearance instead, which also demonstrates the
      app's own Appearance setting rather than describing it.
    */}
    <p class="mb-12 text-center text-muted">
      Every shot exists in both appearances. Use the{' '}
      <span class="font-semibold text-ink">appearance control</span> in the menu bar above to
      switch — HelloNotes itself does the same, following your Mac or pinned in Settings.
    </p>

    <div class="space-y-20">
      {
        SCREENS.map((s, i) => (
          <figure>
            <Shot
              screen={s}
              widths={[640, 1000, 1600]}
              sizes="(max-width: 1000px) 100vw, 1000px"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="w-full rounded-card border border-line shadow-plate"
            />
            <figcaption class="mx-auto mt-5 max-w-[680px] text-center">
              <h2 class="text-[20px] font-bold tracking-[-0.01em]">{s.title}</h2>
              <p class="mt-2 text-muted">{s.body}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-20 border-t border-line pt-10 text-center">
      <p class="text-muted">
        Screenshots show HelloNotes 1.0 on macOS. Interested in how it all works?
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3.5">
        <a
          href={href('/download')}
          class="brand-gradient inline-flex items-center rounded-full px-6 py-3.5 font-bold text-white shadow-cta transition hover:brightness-95"
        >
          Download for Mac
        </a>
        <a
          href={href('/features')}
          class="inline-flex items-center rounded-full border border-line bg-chip px-6 py-3.5 font-bold text-ink transition hover:border-edge hover:text-emphasis"
        >
          Read about the features
        </a>
      </div>
    </div>
  </div>
</PageLayout>

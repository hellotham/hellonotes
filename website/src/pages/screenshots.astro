---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import { href } from '../lib/paths';
import { SCREENS } from '../lib/screens';
---

<PageLayout
  title="Screenshots — HelloNotes"
  description="See HelloNotes in action, in both light and dark appearance: the native Markdown editor, inline maths and diagrams, callouts and properties, the graph view, and on-device AI answering questions from your notes."
  heading="Screenshots"
  intro="A closer look at the editor, the graph, and the on-device intelligence — in either appearance."
>
  <div class="mx-auto max-w-[1000px] px-6 py-12">
    {/*
      The appearance switch is two radio inputs styled as a segmented control.
      Radios rather than a checkbox so each state is separately labelled for a
      screen reader, and CSS rather than JavaScript so the page keeps working
      with scripting off. It defaults to whatever the reader's own system is
      set to, which is also what the rest of the site follows.
    */}
    <div class="shots flex flex-col items-center gap-3">
      <fieldset class="switch inline-flex rounded-full border border-line bg-card p-1">
        <legend class="sr-only">App appearance shown in these screenshots</legend>
        <input class="sr-only" type="radio" name="appearance" id="appearance-light" value="light" />
        <label for="appearance-light">Light</label>
        <input class="sr-only" type="radio" name="appearance" id="appearance-dark" value="dark" />
        <label for="appearance-dark">Dark</label>
      </fieldset>
      <p class="text-sm text-muted">
        HelloNotes follows your Mac, or you can pin it to one appearance in Settings.
      </p>

      <div class="mt-8 w-full space-y-20">
        {
          SCREENS.map((s, i) => (
            <figure>
              <div class="light-only">
                <Image
                  src={s.light}
                  alt={`${s.alt} — light appearance`}
                  widths={[640, 1000, 1600]}
                  sizes="(max-width: 1000px) 100vw, 1000px"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="rounded-card border border-line shadow-[0_30px_80px_rgba(0,0,0,.5)]"
                />
              </div>
              <div class="dark-only">
                <Image
                  src={s.dark}
                  alt={`${s.alt} — dark appearance`}
                  widths={[640, 1000, 1600]}
                  sizes="(max-width: 1000px) 100vw, 1000px"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="rounded-card border border-line shadow-[0_30px_80px_rgba(0,0,0,.5)]"
                />
              </div>
              <figcaption class="mx-auto mt-5 max-w-[680px] text-center">
                <h2 class="text-[20px] font-bold tracking-[-0.01em]">{s.title}</h2>
                <p class="mt-2 text-muted">{s.body}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <div class="mt-20 border-t border-line pt-10 text-center">
      <p class="text-muted">
        Screenshots show HelloNotes 1.0 on macOS. Interested in how it all works?
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3.5">
        <a
          href={href('/download')}
          class="brand-gradient inline-flex items-center rounded-full px-6 py-3.5 font-bold text-white shadow-[0_10px_30px_rgba(236,72,153,.35)] transition hover:brightness-110"
        >
          Download for Mac
        </a>
        <a
          href={href('/features')}
          class="inline-flex items-center rounded-full border border-line bg-white/5 px-6 py-3.5 font-bold text-ink transition hover:border-[#4a4360] hover:text-white"
        >
          Read about the features
        </a>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .switch label {
    cursor: pointer;
    border-radius: 9999px;
    padding: 0.4rem 1.15rem;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-muted);
    transition: background-color 0.15s, color 0.15s;
  }
  .switch input:checked + label,
  .switch.is-auto-light label[for='appearance-light'],
  .switch.is-auto-dark label[for='appearance-dark'] {
    background-image: linear-gradient(115deg, #7c3aed 0%, #ec4899 55%, #f59e0b 100%);
    color: #fff;
  }
  /* Until the reader picks a side, the segment matching their system is the one
     that should read as active — otherwise the control looks broken on load. */
  @media (prefers-color-scheme: light) {
    .switch:not(:has(input:checked)) label[for='appearance-light'] {
      background-image: linear-gradient(115deg, #7c3aed 0%, #ec4899 55%, #f59e0b 100%);
      color: #fff;
    }
  }
  @media not all and (prefers-color-scheme: light) {
    .switch:not(:has(input:checked)) label[for='appearance-dark'] {
      background-image: linear-gradient(115deg, #7c3aed 0%, #ec4899 55%, #f59e0b 100%);
      color: #fff;
    }
  }
  /* Keyboard focus must stay visible even though the radio itself is sr-only. */
  .switch input:focus-visible + label {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  /*
    Neither radio is checked on load, so the default comes from the reader's own
    system preference — the switch then overrides it once they pick a side.
    :has() on the wrapper is what lets a control at the top of the page drive
    figures further down without script.
  */
  .light-only {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    .light-only {
      display: block;
    }
    .dark-only {
      display: none;
    }
  }
  .shots:has(#appearance-light:checked) .light-only {
    display: block;
  }
  .shots:has(#appearance-light:checked) .dark-only {
    display: none;
  }
  .shots:has(#appearance-dark:checked) .dark-only {
    display: block;
  }
  .shots:has(#appearance-dark:checked) .light-only {
    display: none;
  }
</style>

---
import { Image } from 'astro:assets';
import type { Screen } from '../lib/screens';

interface Props {
  screen: Screen;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { screen, widths, sizes, loading = 'lazy', class: className = '' } = Astro.props;

/**
 * A product screenshot that matches the appearance the site is showing.
 *
 * This was a <picture> with a `prefers-color-scheme` source, which is wrong now
 * that the reader can PIN an appearance: a media query only ever sees the
 * system setting, so pinning light on a dark Mac left dark screenshots on a
 * light page. Media queries cannot observe `data-theme`, so instead both shots
 * are emitted and `.only-light` / `.only-dark` (global.css) reveal one — driven
 * by the same rules as the palette, so the two can never disagree.
 *
 * The hidden one costs nothing: it is `display: none`, and a lazy image inside
 * a display:none subtree is never fetched.
 */
const common = { widths, sizes, loading, class: className };
---

<div class="only-light"><Image src={screen.light} alt={screen.alt} {...common} /></div>
<div class="only-dark"><Image src={screen.dark} alt={screen.alt} {...common} /></div>

---
/**
 * Typographic styling for hand-written content (manual sections, privacy,
 * support). Scoped with arbitrary-variant selectors so the pages themselves stay
 * plain semantic HTML instead of repeating utility classes on every element.
 */
---

<div
  class="max-w-[760px]
         [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:scroll-mt-24 [&_h2]:text-[26px] [&_h2]:font-extrabold [&_h2]:tracking-[-0.02em]
         [&_h3]:mt-7 [&_h3]:mb-2 [&_h3]:scroll-mt-24 [&_h3]:text-[19px] [&_h3]:font-bold
         [&_p]:my-3 [&_p]:text-[#d7d3e6]
         [&_ul]:my-3 [&_ul]:ml-6 [&_ul]:list-disc [&_ol]:my-3 [&_ol]:ml-6 [&_ol]:list-decimal
         [&_li]:my-1.5 [&_li]:text-[#d7d3e6] [&_li>ul]:my-1
         [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-white
         [&_strong]:text-ink [&_strong]:font-semibold
         [&_code]:rounded [&_code]:bg-white/8 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.9em]
         [&_kbd]:rounded [&_kbd]:border [&_kbd]:border-line [&_kbd]:bg-white/8 [&_kbd]:px-1.5 [&_kbd]:py-0.5 [&_kbd]:text-[0.85em] [&_kbd]:font-semibold [&_kbd]:text-ink
         [&_table]:my-5 [&_table]:w-full [&_table]:border-collapse [&_table]:text-left [&_table]:text-[15px]
         [&_th]:border-b [&_th]:border-line [&_th]:py-2 [&_th]:pr-4 [&_th]:font-semibold [&_th]:text-ink
         [&_td]:border-b [&_td]:border-line/60 [&_td]:py-2 [&_td]:pr-4 [&_td]:text-[#d7d3e6] [&_td]:align-top
         [&_blockquote]:my-5 [&_blockquote]:rounded-card [&_blockquote]:border [&_blockquote]:border-line [&_blockquote]:bg-card [&_blockquote]:px-6 [&_blockquote]:py-4
         [&_blockquote_p]:my-1
         [&_hr]:my-10 [&_hr]:border-line"
>
  <slot />
</div>

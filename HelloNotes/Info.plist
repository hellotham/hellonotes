<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
				<string>public.plain-text</string>
			</array>
		</dict>
		<dict>
			<!-- **A folder is a document this app opens, and it has to say so.**

			     `LSSupportsOpeningDocumentsInPlace` declares that the app edits
			     documents where they live; this array declares *which kinds*. Without
			     `public.folder` here, the system treats a folder as something
			     HelloNotes cannot open, and third-party File Providers (OneDrive,
			     Box, Dropbox, Google Drive) refuse to vend one to the document
			     picker — you can browse into them and never select a folder. iCloud
			     Drive, the system's own provider, does not enforce it, which is why
			     the failure looked provider-specific instead of self-inflicted. -->
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<!-- Open folders and notes *in place* from any file provider.

	     Without this the system treats the app as unable to edit documents where
	     they live, and third-party File Providers (OneDrive, Box, Google Drive,
	     Dropbox) refuse to hand over a security-scoped folder — while iCloud
	     Drive, the system's own provider, keeps working. The symptom is
	     "the picker browses into OneDrive but the folder can't be selected",
	     and nothing in the code looks wrong, because nothing in the code is. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>DropboxAppKey</key>
	<string>$(DROPBOX_APP_KEY)</string>
	<key>BoxClientID</key>
	<string>$(BOX_CLIENT_ID)</string>
	<key>BoxClientSecret</key>
	<string>$(BOX_CLIENT_SECRET)</string>
	<key>GoogleClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>OneDriveClientID</key>
	<string>$(ONEDRIVE_CLIENT_ID)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>HelloNotes transcribes your voice into a note, on-device.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>HelloNotes transcribes speech into notes on-device.</string>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.daringfireball.markdown</string>
			<key>UTTypeDescription</key>
			<string>Markdown Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>md</string>
					<string>markdown</string>
					<string>mdown</string>
					<string>markdn</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/markdown</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hellotham.hellonotes.deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hellonotes</string>
			</array>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New HelloNotes Note from Selection</string>
			</dict>
			<key>NSMessage</key>
			<string>newNoteFromSelection</string>
			<key>NSPortName</key>
			<string>HelloNotes</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

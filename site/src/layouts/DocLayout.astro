---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  /** Small line under the heading, e.g. "Last updated: 2026". */
  subheading: string;
  footerBadge: string;
  navLinks: { label: string; href: string }[];
  footerLinks: { label: string; href: string }[];
}

const { title, description, heading, subheading, footerBadge, navLinks, footerLinks } =
  Astro.props;
---

<Layout title={title} description={description}>
  <Nav links={navLinks} />

  <main class="px-6 pt-15 pb-[90px]">
    <!-- Prose-ish styling scoped to the slotted content, so the two doc pages
         stay plain semantic HTML rather than repeating utility classes. -->
    <div
      class="mx-auto max-w-[760px]
             [&_h2]:mt-8 [&_h2]:mb-2.5 [&_h2]:text-[22px] [&_h2]:font-bold
             [&_p]:text-[#d7d3e6] [&_li]:text-[#d7d3e6]
             [&_ul]:my-2.5 [&_ul]:ml-[22px] [&_ul]:list-disc [&_li]:my-1.5
             [&_a]:text-link hover:[&_a]:text-white
             [&_code]:rounded [&_code]:bg-white/5 [&_code]:px-1"
    >
      <h1 class="mb-2 text-[clamp(32px,5vw,46px)] font-extrabold tracking-[-0.02em]">
        {heading}
      </h1>
      <p class="mb-8 text-muted">{subheading}</p>
      <slot />
    </div>
  </main>

  <Footer badge={footerBadge} links={footerLinks} />
</Layout>

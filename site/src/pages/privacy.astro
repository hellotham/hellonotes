<DocLayout
  title="Privacy Policy — HelloNotes"
  description="HelloNotes collects nothing: no account, no analytics, no tracking, no servers. Your notes are plain files on your own Mac."
  heading="Privacy Policy"
  subheading="Last updated: 2026"
  footerBadge="🔒 We collect nothing"
  navLinks={[
    { label: 'Home', href: '/' },
    { label: 'Support', href: '/support' },
  ]}
  footerLinks={[
    { label: 'Home', href: '/' },
